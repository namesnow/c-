#include<bits/stdc++.h>
using namespace std;
struct student{
	string student;
	int x,y,z,id;
}a[100];
bool cmp(student a, student b){
if(a.x+a.y+a.z==b.x+b.y+b.z)
return a.id<b.id;
return a.x+a.y+a.z>b.x+b.y+b.z;
}
int main(){
	int n;
	cin>>n;
	student s1,s2,s3; 
    for (int i = 0; i < n; i++){
    	cin>>a[i].student>>a[i].x>>a[i].y>>a[i].z;
		a[i].id = i;}
    sort(a,a+n,cmp);
    cout<<a[0].student<<" "<<a[0].x<<" "<<a[0].y<<" "<<a[0].z;
	
	return 0;
} 
