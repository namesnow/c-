#include<bits/stdc++.h>
using namespace std;
int main(){
int n,m;
int a[1000],b[50];
cin>>n>>m;
for(int i=1;i<=n;i++){
	cin>>a[i];
}
for(int i=1;i<=m;i++){
	cin>>b[i];
}
for(int i=1;i<=m;i++){
int* p=lower_bound(a+1,a+n+1,b[i]);
if(p==a+n+1||*p!=b[i]){
	cout<<"-1";
}else cout<<p-a<<" ";}
return 0;
} 

