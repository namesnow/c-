#include<iostream>
using namespace std;
int ans=0;
int n,k;
int a[100];
bool isprime(int x){
	if(x<=1) return false;
	for(int i=2;i*i<=x;i++){
		if(x%i==0) return false;
	}return true;}

void dfs(int num,int sum,int sid){
	if(num==k) {
	 if(isprime(sum)) ans++;
	 return;}
	 for(int i=sid;i<=n-k+num;++i){
	 	dfs(num+1,sum+a[i],i+1);
	 } 
}
int main(){
	cin>>n>>k;
	for(int m=0;m<n;m++){
		cin>>a[m];
	} 
	dfs(0,0,0);
	cout<<ans<<endl;
	return 0;} 
