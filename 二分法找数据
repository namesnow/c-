#include<bits/stdc++.h>
using namespace std;
int findm(int a[],int l,int r,int k){
    if(l==r){
        if(a[l]==k)
        return l;
        else 
	        return -1;
    }
int mid=(l+r)/2;
if(k<=a[mid]){findm(a,l,mid,k);}
        else findm(a,mid+1,r,k);
}

int main(){
    int n,m;
    cin>>n>>m;
    int a[10000];
    for(int i=1;i<=n;i++) {cin>>a[i];}
    while(m--){
        int k;
        cin>>k;
        cout<<findm(a,1,n,k)<<" ";
}return 0;
}     


